# ==============================================================================
# Environment Configuration - Multi-Role RAG Chatbot (Backend)
# Copy this file to .env and adjust placeholder values.
# NEVER commit your real .env file or real secrets to version control.
# ==============================================================================

# Application Settings
PROJECT_NAME="Multi-Role RAG Chatbot"
ENVIRONMENT=development
DEBUG=True
API_V1_STR=/api
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# PostgreSQL Database Configuration (psycopg 3 driver)
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql+psycopg://rag_user:rag_password@localhost:5432/rag_db
TEST_DATABASE_URL=postgresql+psycopg://rag_user:rag_password@localhost:5432/rag_test_db

# JWT & Authentication Security
# Generate a secure key in production (e.g. `openssl rand -hex 32`)
JWT_SECRET=replace-with-a-secure-random-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_COOKIE_NAME=refresh_token
# Set COOKIE_SECURE=True in production (HTTPS required)
COOKIE_SECURE=False
# Use "lax" for local dev, "none" for cross-origin production (Vercel -> Render)
COOKIE_SAMESITE=lax

# CORS Configuration (Comma-separated list of allowed frontend origins)
# In production, set to your Vercel URL (e.g., https://your-app.vercel.app)
CORS_ORIGINS=http://localhost:5173

# OpenRouter LLM Configuration
# Base URL must remain https://openrouter.ai/api/v1
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Storage & Vector Database Paths
# In local dev: ./chroma_db and ./uploads
# In Render production: mounted persistent disk paths (e.g. /var/data/chroma_db and /var/data/uploads)
CHROMA_PERSIST_DIR=./chroma_db
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# RAG & Embedding Settings
GEMINI_API_KEY=your-gemini-api-key
EMBEDDING_MODEL_NAME=models/text-embedding-004
RAG_TOP_K=4
# Relevance threshold for Chroma default L2 squared distance (lower is closer; calibrate with test corpus)
RAG_DISTANCE_THRESHOLD=1.2
